Screen {
    background: $nx-bg;
    color: $nx-text;
    scrollbar-background: $nx-bg;
    scrollbar-color: $nx-border;
    scrollbar-color-hover: $nx-border-strong;
    scrollbar-color-active: $nx-accent;
}

CommandPalette {
    min-height: 0;
    align-horizontal: center;
}

CommandPalette > Vertical {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 60%;
    margin-top: 0;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

CommandPalette #--results {
    max-height: 8;
    background: $nx-panel;
}

#main-layout {
    width: 100%;
    height: 1fr;
    layers: base overlay;
}

#main-column {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#logs-drawer {
    dock: right;
    width: 36;
    height: 1fr;
    padding: 0 1;
    background: $nx-panel;
    border-left: tall $nx-border-strong;
    color: $nx-text;
}

#logs-titlebar {
    width: 1fr;
    height: 2;
    padding: 0 1;
    border-bottom: solid $nx-border;
}

#logs-title {
    width: 1fr;
    height: 1;
    color: $nx-accent;
    text-style: bold;
    content-align: left middle;
}

#logs-close {
    width: 3;
    min-width: 3;
    height: 1;
    min-height: 1;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: $nx-muted;
}

#logs-close:hover, #logs-close:focus {
    background: $nx-element-hi;
    color: $nx-accent;
}

#logs-scroll {
    width: 1fr;
    height: 1fr;
    padding: 1 0;
    scrollbar-size-vertical: 1;
}

#logs-content {
    width: 1fr;
    height: auto;
    color: $nx-muted;
}

#conversation {
    height: 1fr;
    width: 100%;
    padding: 1 0 1 2;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

#context-header {
    width: 100%;
    height: auto;
    margin: 0 1 1 1;
}

.context-block {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $nx-muted;
}

.context-block:hover {
    background: $nx-element-hi;
    color: $nx-text;
}

.context-block.-empty {
    color: $nx-quiet;
}

/* A sub agent's Task (what the root agent asked) stands apart on light grey;
   the root conversation has none. */
.context-block.-task {
    display: none;
    padding: 0 1 1 1;
    background: $nx-element;
    color: $nx-text;
}

ContextModal {
    align: center middle;
    background: $nx-scrim;
}

#context-modal {
    width: 86%;
    height: 80%;
    padding: 1 2;
    background: $nx-dialog;
}

#context-modal-title {
    height: 2;
    color: $nx-accent;
    text-style: bold;
    border-bottom: solid $nx-border;
}

#context-modal-scroll {
    height: 1fr;
    padding: 1;
}

#context-modal-body {
    width: 100%;
    height: auto;
    color: $nx-text;
}

ToolsModal {
    align: center middle;
    background: $nx-scrim;
}

#context-modal-actions {
    width: 100%;
    height: auto;
}

#context-modal-actions Button {
    width: auto;
    margin: 1 1 0 0;
}

#tools-modal-note {
    height: auto;
    margin-top: 1;
    color: $nx-warning;
}

/* Context and Tools dialogs: a collapsible per group, one per entry inside. */
Collapsible.context-group {
    background: transparent;
    border-top: none;
    padding: 0;
    margin-bottom: 1;
}

Collapsible.context-group > CollapsibleTitle {
    color: $nx-accent;
    padding: 0;
}

Collapsible.context-group > Contents {
    padding: 0 0 0 2;
}

Collapsible.context-entry {
    background: transparent;
    border-top: none;
    padding: 0;
}

Collapsible.context-entry > CollapsibleTitle {
    color: $nx-text;
    padding: 0;
}

Collapsible.context-entry.-error > CollapsibleTitle {
    color: $nx-error;
}

Collapsible.context-entry > Contents {
    padding: 0 0 1 2;
}

Collapsible.context-group > CollapsibleTitle:hover,
Collapsible.context-entry > CollapsibleTitle:hover,
Collapsible.context-group > CollapsibleTitle:focus,
Collapsible.context-entry > CollapsibleTitle:focus {
    background: $nx-element-hi;
    color: $nx-text;
}

.context-entry-body {
    width: 1fr;
    height: auto;
    padding: 0 1;
    background: $nx-element;
    color: $nx-text;
}

.context-entry-empty {
    color: $nx-quiet;
}

ArchivedSessionsScreen {
    align: center middle;
    background: $nx-scrim;
}

#archived-dialog {
    width: 120;
    max-width: 95%;
    max-height: 86%;
    height: auto;
    padding: 1 2;
    background: $nx-dialog;
}

#archived-title {
    height: 2;
    content-align: center middle;
    color: $nx-accent;
    text-style: bold;
}

#archived-search-row {
    height: 3;
    width: 100%;
}

#archived-search {
    width: 1fr;
    border: solid $nx-border;
    background: $nx-field;
}

#archived-search:focus {
    border: solid $nx-border-focus;
}

#archived-content-toggle {
    width: 19;
    padding: 1;
    color: $nx-muted;
}

#archived-body {
    height: 20;
    width: 100%;
}

#archived-list {
    width: 2fr;
    height: 100%;
    border: none;
    background: $nx-dialog;
    scrollbar-size-vertical: 1;
    scrollbar-color: $nx-accent;
}

#archived-list > .option-list--option-highlighted {
    background: $nx-element-hi;
    color: $nx-text;
    text-style: bold;
}

#archived-detail {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    color: $nx-muted;
    background: $nx-panel;
}

#archived-hint {
    height: 1;
    margin-top: 1;
    color: $nx-quiet;
}

.turn {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.timeline-user {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 1 2 1 1;
    border: none;
    background: $nx-panel;
    color: $nx-text;
}

.timeline-assistant {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0 2;
    color: $nx-text;
}

.turn .timeline-after-user {
    margin-top: 1;
}

.timeline-assistant.timeline-after-tool {
    margin-top: 1;
}

.timeline-assistant.timeline-after-tool-diff {
    margin-top: 0;
}

.timeline-summary {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 2;
    color: $nx-quiet;
}

.timeline-summary-after-assistant {
    margin: 0;
}

.timeline-summary-after-tool-diff {
    margin-top: 0;
}

.turn-collapsed {
    width: 100%;
    height: 1;
    padding: 0 2 0 4;
    color: $nx-muted;
}

.tool-card {
    width: 100%;
    /* One header line; Edit/Patch rows grow to hold their inline diff. */
    height: auto;
    margin: 0;
    padding: 0 2;
    background: transparent;
    color: $nx-quiet;
}

.tool-card.-batched #tool-header {
    color: $nx-quiet;
}

.tool-card:hover, .tool-card:focus {
    background: $nx-element;
}

.tool-card .tool-diff-clipped {
    color: $nx-quiet;
}

.tool-card #tool-header {
    width: 100%;
    height: 1;
    color: $nx-quiet;
    text-overflow: ellipsis;
    text-wrap: nowrap;
    overflow-x: hidden;
}

.task-child {
    width: 1fr;
    height: auto;
    min-height: 1;
    margin: 0 0 0 2;
    padding: 0 1;
    background: transparent;
    border: none;
    color: $nx-muted;
    text-align: left;
}

.task-child:focus, .task-child:hover {
    background: $nx-element-hi;
    color: $nx-text;
    border-left: tall $nx-success;
}

/* The subagent page reuses the root ids (#top-bar, #main-layout,
   #details-sidebar); session-level top bar buttons do not apply there. */
.agent-page #topbar-new, .agent-page #topbar-sidebar-toggle {
    display: none;
}

/* The top bar carries the sub agent's name and status; the Task block its task. */
#agent-inspector-heading {
    display: none;
}

#agent-inspector-activity {
    height: auto;
    max-height: 2;
    color: $nx-muted;
    margin: 0 2;
}

#agent-timeline {
    height: 1fr;
    width: 1fr;
}

/* Stands where the composer is, styled like it; a subagent takes no input. */
#agent-inspector-help {
    height: 3;
    margin: 0 2 1 2;
    padding: 0 2;
    content-align: left middle;
    color: $nx-quiet;
    background: $nx-panel;
}

#chat-input {
    height: auto;
    max-height: 22;
    margin: 0 2;
    padding: 0;
    border: none;
    background: $nx-panel;
}

#leader-hint {
    height: auto;
    margin: 0 2;
    color: $nx-accent;
    display: none;
}

VoiceConsentScreen {
    align: center middle;
    background: $nx-scrim;
}

#voice-consent-dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $nx-dialog;
}

#voice-title {
    height: 1;
    margin-bottom: 1;
    color: $nx-accent;
    text-style: bold;
}

#voice-status {
    height: auto;
    min-height: 2;
    color: $nx-text;
}

#voice-actions {
    height: auto;
    margin-top: 1;
}

#voice-actions Button, #voice-retry, #voice-ready {
    width: auto;
    min-width: 14;
    margin-right: 1;
}

#settings-voice-actions {
    height: auto;
    margin-top: 1;
}

#settings-voice-actions Button {
    width: auto;
    margin-right: 1;
}

#voice Select {
    width: 20;
    height: 1;
    border: none;
    background: $nx-panel;
}

#inline-picker {
    display: none;
    width: 1fr;
    height: auto;
    max-height: 8;
    margin: 0 2;
    padding: 0;
    background: $nx-list;
    border: none;
    outline-left: none;
}

#inline-picker #agent-options {
    width: 100%;
    height: auto;
    max-height: 8;
    padding: 0;
    margin: 0;
    border: none;
    background: $nx-list;
    scrollbar-size-vertical: 1;
}

#cwd-path {
    width: 1fr;
    min-width: 1;
    height: 1;
    padding: 0;
    color: $nx-quiet;
    content-align: left middle;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#root-agent {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    color: $nx-text;
    padding: 0;
    content-align: left middle;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#root-agent-name, #root-model-details, #root-model, #root-provider, #root-effort {
    width: auto;
    min-width: 0;
    max-width: 1fr;
    height: 1;
    padding: 0 1;
    color: $nx-muted;
    content-align: left middle;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#bottom-info {
    layers: base overlay;
}

#root-agent-recording {
    layer: overlay;
    position: absolute;
    offset: 0 0;
    width: 1;
    height: 1;
    padding: 0;
    color: #f5a742;
}

#root-separator-model, #root-separator-provider, #root-separator-effort {
    width: auto;
    min-width: 0;
    max-width: 3;
    height: 1;
    padding: 0;
}

#root-agent-name {
    text-style: bold;
}

#root-agent-name, #root-model, #root-provider, #root-effort {
    padding: 0;
}

#root-model {
    color: $nx-text;
}

#root-provider {
    color: $nx-muted;
    text-style: none;
}

#root-effort {
    color: $nx-muted;
}

#root-separator-model, #root-separator-effort {
    color: $nx-quiet;
}

#commands-hint {
    width: auto;
    height: 1;
    color: $nx-quiet;
}

#root-agent-name:hover, #root-agent-name:focus,
#root-model-details:hover, #root-model-details:focus {
    background: $nx-element-hi;
    color: $nx-text;
    text-style: bold;
}

#root-model-details {
    width: 1fr;
}

#picker-help {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    color: $nx-muted;
    background: $nx-list;
}

#context-usage {
    width: auto;
    min-width: 1;
    max-width: 18;
    height: 1;
    color: $nx-quiet;
    content-align: right middle;
    text-align: right;
    padding: 0 2 0 0;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#context-usage:hover, #context-usage:focus {
    color: $nx-text;
    background: $nx-element-hi;
}

#runtime-info {
    width: 100%;
    height: 1;
    padding: 0 2;
    background: $nx-panel;
}

#activity-progress {
    width: 1fr;
    height: 1;
    margin: 0 2;
    padding: 0;
    background: transparent;
}

#context-preview {
    width: 1fr;
    height: auto;
    max-height: 16;
    min-height: 6;
    overflow: hidden;
    margin: 1 2 0 2;
    padding: 1 2;
    background: $nx-panel;
    outline-left: outer $nx-accent;
    color: $nx-muted;
}

#context-preview-heading {
    width: 100%;
    height: 1;
}

#context-preview-controls {
    width: 100%;
    height: auto;
    min-height: 1;
}

#context-preview-controls PickerLink {
    width: auto;
    max-width: 1fr;
    height: 1;
    padding: 0 1;
    color: $nx-muted;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#context-preview-controls PickerLink:hover, #context-preview-controls PickerLink:focus {
    color: $nx-text;
    background: $nx-element-hi;
    text-style: bold;
}

#context-preview-label {
    width: 1fr;
    height: 1;
    color: $nx-accent;
    text-style: bold;
}

#context-preview-more {
    width: auto;
    min-width: 0;
    max-width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $nx-accent;
    content-align: right middle;
    text-align: right;
}

#context-preview-more:hover, #context-preview-more:focus {
    background: $nx-element-hi;
    color: $nx-text;
}

#context-preview-scroll {
    display: none;
}

#context-preview-content {
    width: 1fr;
    height: auto;
    color: $nx-muted;
}

#context-preview-content .markdown-heading {
    color: $nx-accent;
    text-style: bold;
}

#context-preview-content .markdown-paragraph {
    margin: 0;
}

#bottom-info {
    width: 100%;
    height: 1;
    margin: 0;
    padding: 0;
    background: $nx-panel;
    align-horizontal: right;
}

#chat-editor {
    height: auto;
    min-height: 3;
    max-height: 8;
    padding: 1 2;
    border: none;
    background: transparent;
    color: $nx-text;
}

#chat-editor:focus {
    border: none;
}

#completion-popup {
    width: 100%;
    height: auto;
    max-height: 8;
    margin: 0;
    padding: 0 0 0 1;
    background: $nx-list;
    border-top: tall $nx-element-hi;
    border-bottom: tall $nx-element-hi;
    border-left: none;
    border-right: none;
    color: $nx-quiet;
}

#completion-popup Static {
    padding: 0;
}

#connection-status {
    height: auto;
    max-height: 2;
    margin: 0;
    padding: 0;
    background: $nx-bg;
    color: $nx-quiet;
}

#connection-status.error {
    color: $nx-error;
}

#agent-picker-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 78%;
    padding: 1 2;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

ModelPickerScreen {
    align: center middle;
    background: $nx-bg 65%;
}

#model-picker-dialog {
    width: 84%;
    max-width: 90;
    height: 72%;
    padding: 1 2;
    background: $nx-panel;
}

#model-picker-title {
    height: 2;
    color: $nx-text;
    text-style: bold;
}

#model-picker-search {
    height: 1;
    margin-bottom: 1;
    padding: 0;
    border: none;
    background: $nx-panel;
}

#model-picker-options {
    height: 1fr;
    border: none;
    background: $nx-panel;
    scrollbar-size-vertical: 1;
}

#model-picker-options > .option-list--option {
    height: 1;
    padding: 0 1;
}

#context-dialog {
    width: 96%;
    max-width: 120;
    height: 90%;
    max-height: 90%;
    padding: 1 2;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

#context-title {
    height: 1;
    margin-bottom: 1;
    color: $nx-accent;
    text-style: bold;
}

#context-scroll {
    width: 1fr;
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#context-details {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    color: $nx-muted;
}

#context-help {
    height: 1;
    margin-top: 1;
    color: $nx-quiet;
}

#agent-options {
    margin-bottom: 0;
}

#inline-picker #agent-options {
    margin-bottom: 0;
}

#inline-picker #picker-help {
    display: block;
}

#agent-options {
    max-height: 7;
}

#inline-picker OptionList > .option-list--option {
    padding: 0 1;
}

OptionList {
    background: $nx-bg;
    color: $nx-muted;
}

OptionList > .option-list--option-highlighted {
    background: $nx-element-hi;
    color: $nx-text;
}

/* Screenshot fixture for the reference Terminal TUI; the live shell keeps its
   normal compact controls and palette. */
.reference-demo {
    background: $nx-bg;
    color: $nx-text;
    scrollbar-background: $nx-bg;
    scrollbar-color: $nx-border;
    scrollbar-color-hover: $nx-border-strong;
    scrollbar-color-active: $nx-blue;
}

.reference-demo #conversation {
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

.reference-demo .timeline-user {
    margin: 0 0 1 0;
    padding: 1 2;
    border-left: tall $nx-blue;
    background: $nx-panel;
    color: $nx-text;
}

.reference-demo .turn:first-child .timeline-user {
    margin-bottom: 1;
}

.reference-demo .timeline-assistant {
    margin: 0 0 1 2;
    padding: 0;
    color: $nx-text;
}

.reference-demo .tool-card {
    margin: 0 0 0 2;
    padding: 0;
    border-left: none;
    background: transparent;
    color: $nx-muted;
}

.reference-demo .timeline-summary {
    margin: 0 0 0 2;
    padding: 0;
    color: $nx-quiet;
}

.reference-demo #chat-input {
    margin: 0 2;
    padding: 0 1 0 2;
    background: $nx-panel;
    border-left: tall $nx-blue;
}

.reference-demo #chat-editor,
.reference-demo #runtime-info {
    background: $nx-panel;
}

.reference-demo #chat-editor {
    height: 3;
    min-height: 3;
    padding: 0;
}

.reference-demo #runtime-info {
    color: $nx-text;
}

.reference-demo #root-agent-name {
    width: 1fr;
    color: $nx-text;
    text-style: none;
}

.reference-demo #runtime-info {
    height: 1;
}

.reference-demo #root-separator-provider,
.reference-demo #root-provider,
.reference-demo #root-separator-effort,
.reference-demo #root-effort {
    display: none;
}

.reference-demo #bottom-info {
    height: 2;
    padding-top: 0;
    background: $nx-bg;
}

.reference-demo #cwd-path {
    padding-left: 2;
    color: $nx-muted;
}

.reference-demo #context-usage {
    width: 40;
    max-width: 40;
    padding-right: 2;
    color: $nx-muted;
}

.reference-demo .tool-card #tool-header {
    text-style: none;
}

.reference-demo .timeline-assistant .markdown-h3 {
    color: $nx-accent;
    text-style: none;
}

.reference-demo .timeline-assistant MarkdownBlock > .code_inline {
    color: $nx-success;
    background: transparent;
}

.reference-demo .timeline-assistant MarkdownFence {
    background: transparent;
    margin: 1 0;
}

.reference-demo .timeline-assistant MarkdownFence > Label {
    background: transparent;
    padding: 0;
    color: $nx-error !important;
}

#worktrees-dialog, #worktree-confirm-dialog {
    width: 96%;
    max-width: 150;
    height: 90%;
    max-height: 90%;
    padding: 1 2;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

#worktree-confirm-dialog {
    width: 88%;
    max-width: 110;
    height: auto;
    max-height: 88%;
}

#worktrees-title, #worktree-confirm-title {
    height: 1;
    margin-bottom: 1;
    color: $nx-accent;
    text-style: bold;
}

#worktrees-content {
    height: 1fr;
    min-height: 5;
}

#worktrees-list-column {
    width: 32%;
    min-width: 18;
    border-right: solid $nx-border;
    padding-right: 1;
}

#worktrees-list-heading {
    height: 1;
    color: $nx-purple;
    text-style: bold;
}

#worktrees-list-scroll, #worktrees-detail-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#worktrees-list-items {
    height: auto;
}

#worktrees-list-items Button {
    width: 1fr;
    margin: 0;
    background: transparent;
    color: $nx-muted;
    text-align: left;
}

#worktrees-list-items Button:hover, #worktrees-list-items Button:focus {
    background: $nx-element-hi;
    color: $nx-text;
    border-left: tall $nx-accent;
}

#worktrees-detail-column {
    width: 1fr;
    padding-left: 1;
}

#worktrees-status {
    height: auto;
    max-height: 2;
    margin-bottom: 1;
    color: $nx-muted;
}

#worktrees-status.error {
    color: $nx-error;
}

#worktrees-detail, #worktree-confirm-description {
    width: 1fr;
    height: auto;
    color: $nx-text;
}

#worktrees-actions, #worktrees-pages, #worktree-confirm-actions {
    height: auto;
    min-height: 2;
    margin-top: 1;
}

#worktrees-actions Button, #worktrees-pages Button, #worktree-confirm-actions Button {
    width: auto;
    min-width: 12;
    margin: 0 1 0 0;
}

#worktree-confirm-description {
    max-height: 1fr;
    overflow-y: auto;
}

/* ---------------------------------------------------------------- sidebars */
#session-sidebar {
    width: 34;
    height: 1fr;
    padding: 1 1 0 1;
    background: $nx-panel;
    border-right: solid $nx-border;
}

/* Narrow widths: the toggle opens the sidebar over the chat column. */
#session-sidebar.-overlay {
    position: absolute;
    layer: overlay;
    height: 100%;
    border-right: solid $nx-accent;
}

#new-session {
    height: 1;
    padding: 0 1;
    background: $nx-element;
    color: $nx-text;
}

#new-session:hover {
    background: $nx-element-hi;
    color: $nx-accent;
}

#session-filter {
    height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    border: none;
    background: $nx-panel;
    color: $nx-text;
}

#session-filter:focus {
    background: $nx-element;
}

#sessions-heading {
    height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    color: $nx-quiet;
    text-style: bold;
}

#session-list {
    height: 1fr;
    scrollbar-size-vertical: 0;
}

.session-day {
    height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    color: $nx-purple;
    text-style: bold;
}

.session-row {
    height: 1;
    padding: 0 0 0 1;
    background: $nx-panel;
}

.session-row:hover {
    background: $nx-element;
}

.session-row:focus {
    background: $nx-element-hi;
}

.session-row.-active {
    background: $nx-element-hi;
}

.session-glyph {
    width: 2;
    height: 1;
    color: $nx-quiet;
}

.session-row.-active .session-glyph {
    color: $nx-accent;
}

.session-row.-working .session-glyph, .session-row.-working .session-sub {
    color: $nx-accent;
}

.session-row.-input .session-glyph, .session-row.-input .session-sub {
    color: $nx-warning;
}

.session-row.-done .session-glyph, .session-row.-done .session-sub {
    color: $nx-success;
}

.session-row.-done .session-title, .session-row.-active .session-title {
    color: $nx-text;
    text-style: bold;
}

.session-title {
    width: 1fr;
    height: 1;
    color: $nx-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.session-sub {
    width: auto;
    max-width: 12;
    height: 1;
    padding: 0 0 0 1;
    color: $nx-quiet;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.session-delete {
    width: 2;
    height: 1;
    padding: 0 0 0 1;
    color: $nx-quiet;
    visibility: visible;
}

.session-delete:hover {
    color: $nx-error;
}

.session-row.-archived .session-title, .session-row.-archived .session-glyph {
    color: $nx-quiet;
}

#sidebar-archived {
    height: 1;
    padding: 0 1;
    color: $nx-muted;
}

#sidebar-archived:hover {
    background: $nx-element-hi;
    color: $nx-text;
}

#sidebar-hint {
    height: 1;
    margin: 1 0 1 0;
    padding: 0 1;
    color: $nx-quiet;
}

/* ---------------------------------------------------------------- top bar */
#top-bar {
    height: 2;
    width: 100%;
    background: $nx-panel;
    border-bottom: solid $nx-border;
}

.topbar-button {
    width: 3;
    height: 1;
    content-align: center middle;
    color: $nx-muted;
}

.topbar-button:hover {
    background: $nx-element-hi;
    color: $nx-text;
}

.topbar-button.-on {
    color: $nx-accent;
}

#topbar-crumb {
    width: 1fr;
    height: 1;
    padding: 0 0 0 1;
    color: $nx-text;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

#topbar-status {
    width: auto;
    padding: 0 2;
    color: $nx-quiet;
}

#top-bar.-working #topbar-status {
    color: $nx-accent;
}

#top-bar.-input #topbar-status {
    color: $nx-warning;
}

#top-bar.-done #topbar-status {
    color: $nx-success;
}

#details-sidebar {
    width: 42;
    height: 1fr;
    padding: 1 2;
    background: $nx-panel;
    border-left: solid $nx-border;
    scrollbar-size-vertical: 0;
}

.panel-title, #mcp-title {
    height: 1;
    margin: 1 0 1 0;
    color: $nx-quiet;
    text-style: bold;
}

#details-sidebar > .panel-title:first-child {
    margin-top: 0;
}

#details-session {
    height: auto;
    color: $nx-text;
}

#details-files {
    height: auto;
}

.file-row {
    height: 1;
    padding: 0 1;
    margin: 0 -1;
    color: $nx-text;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.file-row:hover, .file-row:focus {
    background: $nx-element-hi;
}

.file-diff {
    height: auto;
    max-height: 18;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $nx-bg;
    overflow-y: auto;
}

.panel-empty {
    height: auto;
    color: $nx-quiet;
}

#mcp-heading {
    height: 3;
}

#mcp-title {
    width: 1fr;
}

#mcp-refresh {
    width: 3;
    height: 1;
    margin: 1 0 0 0;
    color: $nx-quiet;
    content-align: right middle;
}

#mcp-refresh:hover {
    color: $nx-accent;
}

#details-mcp {
    height: auto;
}

/* ---------------------------------------------------------------- settings */
SettingsScreen {
    align: center middle;
    background: $nx-bg 60%;
}

#settings-dialog {
    width: 96;
    max-width: 96%;
    height: 28;
    max-height: 90%;
    background: $nx-panel;
}

SettingsConsole {
    align: left top;
    background: $nx-bg;
}

/* Full-screen page: left sidebar of areas, content on the right. */
#settings-console {
    width: 100%;
    height: 1fr;
    background: $nx-bg;
}

#settings-console #settings-nav {
    width: 26;
    height: 100%;
}

#settings-console #settings-sections > .option-list--option-disabled {
    color: $nx-quiet;
    text-style: bold;
}

#settings-console #settings-panes {
    width: 1fr;
    height: 100%;
}

#settings-file-pane {
    width: 100%;
    height: 100%;
    padding: 1 3;
}

#settings-scope-row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#settings-scope-row Button {
    width: auto;
    min-width: 9;
    margin-right: 1;
    background: $nx-panel;
    color: $nx-muted;
}

#settings-scope-row Button.-current {
    background: $nx-settings-border;
    color: $nx-settings-accent;
}

#settings-default-agent-row {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#settings-default-agent-label {
    width: auto;
    height: 1;
    margin-right: 2;
    color: $nx-muted;
}

#settings-default-agent-choices {
    width: auto;
    height: 1;
}

#settings-default-agent-choices Button {
    width: auto;
    min-width: 7;
    margin-right: 1;
    background: $nx-panel;
    color: $nx-muted;
}

#settings-default-agent-choices Button.-current {
    background: $nx-settings-border;
    color: $nx-settings-accent;
}

#settings-default-agent-note {
    width: 1fr;
    height: 1;
    color: $nx-quiet;
}

#settings-scope-path {
    width: 1fr;
    height: 1;
    text-align: right;
    color: $nx-muted;
}

#settings-file-body {
    width: 100%;
    height: 1fr;
}

#settings-file-list-pane {
    width: 30;
    height: 100%;
    padding-right: 1;
}

#settings-file-list {
    width: 100%;
    height: 1fr;
    border: none;
    background: $nx-bg;
    scrollbar-color: $nx-settings-accent;
}

#settings-file-list > .option-list--option-highlighted {
    background: $nx-element-hi;
    color: $nx-text;
}

#settings-file-editor-pane {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

#settings-file-title {
    width: 100%;
    height: 2;
    color: $nx-settings-accent;
    text-style: bold;
}

#agent-form {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.agent-form-row {
    width: 100%;
    height: 1;
}

.agent-form-label {
    width: 12;
    height: 1;
    color: $nx-muted;
}

/* Model and fallback rows open the shared model picker. */
.agent-form-row Button {
    background: $nx-field;
    color: $nx-text;
    text-style: none;
}

.agent-form-row Button:hover, .agent-form-row Button:focus {
    background: $nx-element-hi;
    text-style: none;
}

.agent-form-pick {
    width: 1fr;
    text-align: left;
    content-align: left middle;
}

.agent-form-remove {
    width: 3;
    min-width: 3;
    margin-left: 1;
}

#agent-fallback-add {
    width: auto;
    background: transparent;
    color: $nx-muted;
}

.agent-fallback-row, #agent-fallback-add-row {
    margin-top: 1;
}

/* Every Settings text field: one row, no border or focus outline. */
SettingsScreen Input, SettingsScreen Input:focus {
    height: 1;
    border: none;
    padding: 0 1;
    background: $nx-field;
}

#settings-file-editor {
    width: 100%;
    height: 1fr;
    background: $nx-field;
    border: solid $nx-settings-border;
}

#settings-file-status {
    width: 100%;
    height: 2;
    color: $nx-muted;
}

#settings-file-actions {
    height: 1;
}

/* Full-size terminal buttons share one row. */
Button {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
}

#settings-new {
    width: auto;
    margin-bottom: 1;
}

#settings-file-actions Button {
    width: auto;
    min-width: 8;
    margin-right: 1;
}

#settings-file-actions #settings-delete {
    min-width: 20;
}

/* Settings → Providers (ui_support/tui_providers.py) */
#providers {
    padding: 1 3;
}

.provider-card {
    height: auto;
    padding: 0 0 1 0;
    margin-bottom: 1;
    border-bottom: solid $nx-border;
}

.provider-head {
    height: 1;
}

.provider-name {
    width: 1fr;
    height: 1;
    color: $nx-text;
    text-style: bold;
}

.provider-state {
    width: auto;
    height: 1;
    color: $nx-quiet;
}

.provider-card.-connected .provider-state {
    color: $nx-settings-accent;
}

.provider-help {
    height: auto;
    color: $nx-muted;
}

.provider-actions {
    height: auto;
    margin-top: 1;
}

.provider-actions Button {
    width: auto;
    min-width: 8;
    margin-right: 1;
    background: $nx-panel;
    color: $nx-muted;
}

.provider-actions Button.provider-action {
    background: $nx-settings-border;
    color: $nx-settings-accent;
}

.provider-input {
    width: 36;
    height: 1;
    border: none;
    margin-right: 1;
    padding: 0 1;
    background: $nx-panel;
}

.provider-flow {
    height: auto;
    margin-top: 1;
    color: $nx-text;
}

#settings-console-hint {
    dock: bottom;
    height: 1;
    padding: 0 2;
    color: $nx-quiet;
}

ConfirmSettingsAction {
    align: center middle;
    background: $nx-scrim;
}

#settings-confirm-dialog {
    width: 60;
    max-height: 85%;
    overflow-y: auto;
    height: auto;
    padding: 1 2;
    background: $nx-settings-panel;
    border: solid $nx-settings-border;
}

#settings-confirm-dialog Horizontal {
    height: auto;
}

#settings-confirm-dialog Button {
    margin-right: 1;
}

#settings-confirm-text {
    height: auto;
    margin-bottom: 1;
}

#settings-nav {
    width: 24;
    height: 1fr;
    padding: 1 1;
    background: $nx-bg;
    border-right: solid $nx-border;
}

#settings-title {
    height: 1;
    margin: 0 1 1 1;
    color: $nx-text;
    text-style: bold;
}

#settings-sections {
    height: 1fr;
    border: none;
    padding: 0;
    background: $nx-bg;
}

#settings-sections > .option-list--option {
    padding: 0 1;
}

#settings-hint {
    height: 1;
    padding: 0 1;
    color: $nx-quiet;
}

#settings-panes {
    width: 1fr;
    height: 1fr;
}

#settings-panes > VerticalScroll {
    padding: 1 3;
}

.settings-heading {
    height: 1;
    color: $nx-text;
    text-style: bold;
}

.settings-help {
    height: auto;
    margin: 0 0 1 0;
    color: $nx-muted;
}

#settings-theme {
    width: 100%;
    border: none;
    background: $nx-panel;
    padding: 0;
}

#settings-theme RadioButton {
    padding: 0 1;
    background: $nx-panel;
}

.settings-row {
    height: 1;
    border: none;
}

.settings-label {
    width: 1fr;
    height: 1;
    content-align: left middle;
    color: $nx-text;
}

.settings-key {
    width: 10;
    height: 1;
    content-align: right middle;
    color: $nx-quiet;
}

.settings-row Switch {
    height: 1;
    border: none;
    background: $nx-panel;
}

#settings-keys, #settings-health {
    height: auto;
    color: $nx-text;
}

/* ---------------------------------------------------------------- opencode timeline */
.timeline-thought {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 3;
    color: $nx-accent 70%;
}

.timeline-thought:hover, .timeline-thought:focus {
    color: $nx-accent;
}

.tool-card.-failed #tool-header {
    color: $nx-error;
}

.tool-card.task-card {
    background: transparent;
    border-left: none;
    padding: 0 3;
}

.tool-card.task-card:hover, .tool-card.task-card:focus {
    background: $nx-panel;
}

.tool-card.task-card #task-metrics {
    width: 1fr;
    height: auto;
    margin-left: 2;
    color: $nx-muted;
}


.timeline-assistant MarkdownBlock > .code_inline {
    color: $nx-warning;
    background: $nx-element-hi;
}

.timeline-assistant .markdown-h1 {
    color: $nx-accent;
}

.timeline-assistant .markdown-h2 {
    color: $nx-purple;
}

.timeline-assistant .markdown-h3 {
    color: $nx-success;
}

.timeline-assistant .markdown-h4 {
    color: $nx-warning;
}

.timeline-assistant MarkdownFence,
.timeline-assistant MarkdownBlockQuote {
    background: $nx-panel;
}

.timeline-assistant MarkdownBlockQuote {
    border-left: solid $nx-accent;
}

.timeline-error {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 2;
    background: transparent;
    color: $nx-error;
}

/* ---------------------------------------------------------------- sessions dialog */
SessionsScreen {
    align: center middle;
    background: $nx-bg 60%;
}

#sessions-dialog {
    width: 100;
    max-width: 94%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $nx-panel;
}

#sessions-header {
    height: 1;
    margin: 0 1 1 1;
}

#sessions-title {
    width: 1fr;
    color: $nx-text;
    text-style: bold;
}

#sessions-esc {
    width: auto;
    color: $nx-quiet;
}

#sessions-search {
    height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $nx-panel;
    color: $nx-text;
}

#sessions-search:focus {
    border: none;
}

#sessions-options {
    height: auto;
    max-height: 24;
    border: none;
    padding: 0;
    background: $nx-panel;
    scrollbar-size-vertical: 0;
}

#sessions-options > .option-list--option {
    padding: 0 1;
}

#sessions-options > .option-list--option-disabled {
    text-style: none;
    color: $nx-text;
}

#sessions-footer {
    height: 1;
    margin: 1 1 0 1;
    color: $nx-quiet;
}

#paste-attachments {
    height: auto;
    max-height: 4;
    margin: 0 2;
    display: none;
}

.pasted-content-pill {
    width: auto;
    height: 1;
    margin-right: 1;
    background: $nx-element;
}

.pasted-content-label {
    width: auto;
    padding: 0 1;
    color: $nx-muted;
    background: $nx-element;
}

.pasted-content-label:hover {
    color: $nx-text;
    background: $nx-element-hi;
}

.pasted-content-remove {
    width: 3;
    min-width: 3;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
    background: $nx-element;
    color: $nx-quiet;
}

.pasted-content-remove:hover, .pasted-content-remove:focus {
    background: $nx-element-hi;
    color: $nx-error;
}

/* First-run setup: connect a provider (ui_support/tui_setup.py) */
SetupScreen {
    align: center middle;
    background: $nx-bg 80%;
}

#setup-dialog {
    width: 90;
    max-width: 94%;
    height: 90%;
    max-height: 44;
    padding: 1 2;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

#setup-title {
    height: 2;
    color: $nx-accent;
    text-style: bold;
}

#setup-intro, #setup-env, #setup-message {
    height: auto;
    margin-bottom: 1;
    color: $nx-muted;
}

#setup-dialog #providers {
    height: 1fr;
    padding: 0;
    background: $nx-panel;
}

#setup-buttons {
    height: 1;
    align-horizontal: right;
}

#setup-buttons Button {
    margin-left: 1;
}

.settings-heading-row { height: 1; margin-bottom: 1; }
.settings-heading-row .settings-heading { width: 1fr; }
.settings-heading-row Button { width: auto; }

#voice SelectCurrent { height: 1; border: none; padding: 0 1; }
.settings-row Switch .switch--slider { color: $nx-muted; background: $nx-element; }
.settings-row Switch.-on .switch--slider { color: $nx-accent; }

/* Keep the worktree action labels reachable beside the child list. */
#worktrees-actions {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 1;
    grid-gutter: 1 1;
    height: 3;
}
#worktrees-actions Button {
    width: 1fr;
    min-width: 8;
    margin: 0;
}
