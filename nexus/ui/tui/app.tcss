Screen {
    background: $nx-bg;
    color: $nx-text;
    scrollbar-background: $nx-bg;
    scrollbar-color: $nx-border;
    scrollbar-color-hover: $nx-border-strong;
    scrollbar-color-active: $nx-accent;
}

CommandPalette {
    min-height: 0;
    align-horizontal: center;
}

CommandPalette > Vertical {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 60%;
    margin-top: 0;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

CommandPalette #--results {
    max-height: 8;
    background: $nx-panel;
}

#main-layout {
    width: 100%;
    height: 1fr;
}

#main-column {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#logs-drawer {
    dock: right;
    width: 36;
    height: 1fr;
    padding: 0 1;
    background: $nx-panel;
    border-left: tall $nx-border-strong;
    color: $nx-text;
}

#logs-titlebar {
    width: 1fr;
    height: 2;
    padding: 0 1;
    border-bottom: solid $nx-border;
}

#logs-title {
    width: 1fr;
    height: 1;
    color: $nx-accent;
    text-style: bold;
    content-align: left middle;
}

#logs-close {
    width: 3;
    min-width: 3;
    height: 1;
    min-height: 1;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: $nx-muted;
}

#logs-close:hover, #logs-close:focus {
    background: $nx-element-hi;
    color: $nx-accent;
}

#logs-scroll {
    width: 1fr;
    height: 1fr;
    padding: 1 0;
    scrollbar-size-vertical: 1;
}

#logs-content {
    width: 1fr;
    height: auto;
    color: $nx-muted;
}

#conversation {
    height: 1fr;
    width: 100%;
    padding: 0 3;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

.turn {
    width: 100%;
    height: auto;
}

.timeline-user {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 1 2;
    border: none;
    background: $nx-element;
    color: $nx-text;
}

.timeline-assistant {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $nx-text;
}

.timeline-summary {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $nx-quiet;
}

.tool-card {
    width: 100%;
    height: auto;
    margin: 0 0 0 1;
    padding: 0 1;
    border-left: tall $nx-border;
    background: $nx-panel;
    color: $nx-muted;
}

.tool-card:hover, .tool-card:focus {
    background: $nx-element-hi;
    border-left: tall $nx-accent;
}

.tool-card #tool-header {
    width: 100%;
    height: auto;
    color: $nx-accent;
    text-style: bold;
}

.tool-card #tool-detail, .tool-card #tool-expanded {
    width: 100%;
    height: auto;
    color: $nx-muted;
    padding-left: 1;
}

.tool-card #tool-expanded {
    max-height: 14;
    overflow-y: auto;
}

.tool-diff-view {
    width: 100%;
    height: auto;
    max-height: 24;
    margin: 0 0 1 0;
}

.task-child {
    width: 1fr;
    height: auto;
    min-height: 1;
    margin: 0 0 0 2;
    padding: 0 1;
    background: transparent;
    border: none;
    color: $nx-muted;
    text-align: left;
}

.task-child:focus, .task-child:hover {
    background: $nx-element-hi;
    color: $nx-text;
    border-left: tall $nx-success;
}

#agent-inspector {
    width: 95%;
    max-width: 112;
    height: 86%;
    padding: 1 2;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

#agent-inspector-heading {
    height: auto;
    max-height: 3;
    color: $nx-purple;
    text-style: bold;
    margin-bottom: 1;
}

#agent-inspector-scroll {
    height: 1fr;
    width: 1fr;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
}

#agent-inspector-transcript {
    width: 1fr;
    padding: 0 1;
}

#agent-inspector-help {
    height: 1;
    color: $nx-quiet;
    margin-top: 1;
}

#chat-input {
    height: auto;
    max-height: 16;
    padding: 0;
    border: none;
    background: $nx-element;
}

#inline-picker {
    display: none;
    width: 100%;
    height: auto;
    max-height: 11;
    margin: 0;
    padding: 0;
    background: $nx-element;
    border: solid $nx-border;
}

#inline-picker #agent-options {
    width: 100%;
    height: auto;
    max-height: 7;
    padding: 0;
    margin: 0;
    border: none;
    background: $nx-element;
    scrollbar-size-vertical: 1;
}

#cwd-path {
    width: 1fr;
    min-width: 1;
    height: 1;
    padding: 0;
    color: $nx-quiet;
    content-align: left middle;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#root-agent {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    color: $nx-text;
    padding: 0;
    content-align: left middle;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#root-agent-name, #root-model-details, #root-model, #root-provider, #root-effort {
    width: auto;
    min-width: 0;
    max-width: 1fr;
    height: 1;
    padding: 0 1;
    color: $nx-muted;
    content-align: left middle;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#root-separator-model, #root-separator-provider, #root-separator-effort {
    width: auto;
    min-width: 0;
    max-width: 1;
    height: 1;
    padding: 0;
}

#root-agent-name {
    text-style: bold;
}

#root-agent-name:hover, #root-agent-name:focus,
#root-model-details:hover, #root-model-details:focus {
    background: $nx-element-hi;
    color: $nx-text;
    text-style: bold;
}

#root-model-details {
    width: 1fr;
}

#picker-help {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    color: $nx-muted;
    background: $nx-element;
}

#context-usage {
    width: auto;
    min-width: 1;
    max-width: 18;
    height: 1;
    color: $nx-accent;
    content-align: right middle;
    text-align: right;
    padding: 0;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#context-usage:hover, #context-usage:focus {
    color: $nx-text;
    background: $nx-element-hi;
}

#runtime-info {
    width: 100%;
    height: 1;
    padding: 0;
    background: $nx-element;
}

#context-preview {
    width: 100%;
    height: auto;
    max-height: 14;
    min-height: 6;
    overflow: hidden;
    padding: 0 1;
    background: $nx-panel;
    border-top: solid $nx-border;
    color: $nx-muted;
}

#context-preview-heading {
    width: 100%;
    height: 1;
}

#context-preview-controls {
    width: 100%;
    height: auto;
    min-height: 1;
}

#context-preview-controls PickerLink {
    width: auto;
    max-width: 1fr;
    height: 1;
    padding: 0 1;
    color: $nx-muted;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

#context-preview-controls PickerLink:hover, #context-preview-controls PickerLink:focus {
    color: $nx-text;
    background: $nx-element-hi;
    text-style: bold;
}

#context-preview-label {
    width: 1fr;
    height: 1;
    color: $nx-accent;
    text-style: bold;
}

#context-preview-more {
    width: auto;
    min-width: 0;
    max-width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $nx-accent;
    content-align: right middle;
    text-align: right;
}

#context-preview-more:hover, #context-preview-more:focus {
    background: $nx-element-hi;
    color: $nx-text;
}

#context-preview-scroll {
    display: none;
}

#context-preview-content {
    width: 1fr;
    height: auto;
    color: $nx-muted;
}

#context-preview-content .markdown-heading {
    color: $nx-accent;
    text-style: bold;
}

#context-preview-content .markdown-paragraph {
    margin: 0;
}

#bottom-info {
    width: 100%;
    height: 1;
    padding: 0;
    background: $nx-element;
}

#chat-editor {
    height: 3;
    min-height: 3;
    padding: 0 1;
    border: none;
    background: $nx-element;
    color: $nx-text;
}

#chat-editor:focus {
    border: none;
}

#completion-popup {
    width: 100%;
    height: auto;
    max-height: 7;
    margin: 0;
    padding: 0;
    background: $nx-panel;
    border: solid $nx-border;
    color: $nx-muted;
}

#completion-popup Static {
    padding: 0;
}

#connection-status {
    height: auto;
    max-height: 2;
    margin: 0;
    padding: 0;
    background: $nx-bg;
    color: $nx-quiet;
}

#connection-status.error {
    color: $nx-error;
}

#agent-picker-dialog, #permission-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 78%;
    padding: 1 2;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

#context-dialog {
    width: 96%;
    max-width: 120;
    height: 90%;
    max-height: 90%;
    padding: 1 2;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

#context-title {
    height: 1;
    margin-bottom: 1;
    color: $nx-accent;
    text-style: bold;
}

#context-scroll {
    width: 1fr;
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#context-details {
    width: 1fr;
    height: auto;
    color: $nx-text;
}

#context-help {
    height: 1;
    margin-top: 1;
    color: $nx-quiet;
}

#agent-options {
    margin-bottom: 1;
}

#inline-picker #agent-options {
    margin-bottom: 0;
}

#inline-picker #picker-help {
    display: block;
}

#agent-options {
    max-height: 7;
}

#inline-picker OptionList > .option-list--option {
    padding: 0 1;
}

OptionList {
    background: $nx-bg;
    color: $nx-muted;
}

OptionList > .option-list--option-highlighted {
    background: $nx-accent;
    color: $nx-on-accent;
}

/* Screenshot fixture for the reference Terminal TUI; the live shell keeps its
   normal compact controls and palette. */
.reference-demo {
    background: $nx-bg;
    color: $nx-text;
    scrollbar-background: $nx-bg;
    scrollbar-color: $nx-border;
    scrollbar-color-hover: $nx-border-strong;
    scrollbar-color-active: $nx-blue;
}

.reference-demo #conversation {
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

.reference-demo .timeline-user {
    margin: 0 0 1 0;
    padding: 1 2;
    border-left: tall $nx-blue;
    background: $nx-panel;
    color: $nx-text;
}

.reference-demo .turn:first-child .timeline-user {
    margin-bottom: 1;
}

.reference-demo .timeline-assistant {
    margin: 0 0 1 2;
    padding: 0;
    color: $nx-text;
}

.reference-demo .tool-card {
    margin: 0 0 0 2;
    padding: 0;
    border-left: none;
    background: transparent;
    color: $nx-muted;
}

.reference-demo .timeline-summary {
    margin: 0 0 0 2;
    padding: 0;
    color: $nx-quiet;
}

.reference-demo #chat-input {
    margin: 0 2;
    padding: 0 1 0 2;
    background: $nx-panel;
    border-left: tall $nx-blue;
}

.reference-demo #chat-editor,
.reference-demo #runtime-info {
    background: $nx-panel;
}

.reference-demo #chat-editor {
    height: 4;
    min-height: 4;
    padding: 0;
}

.reference-demo #runtime-info {
    color: $nx-text;
}

.reference-demo #root-agent-name {
    width: 1fr;
    color: $nx-text;
    text-style: none;
}

.reference-demo #runtime-info {
    height: 1;
}

.reference-demo #root-separator-provider,
.reference-demo #root-provider,
.reference-demo #root-separator-effort,
.reference-demo #root-effort {
    display: none;
}

.reference-demo #bottom-info {
    height: 2;
    padding-top: 0;
    background: $nx-bg;
}

.reference-demo #cwd-path {
    padding-left: 2;
    color: $nx-muted;
}

.reference-demo #context-usage {
    width: 40;
    max-width: 40;
    padding-right: 2;
    color: $nx-muted;
}

.reference-demo .tool-card #tool-header {
    text-style: none;
}

.reference-demo .timeline-assistant .markdown-h3 {
    color: $nx-accent;
    text-style: none;
}

.reference-demo .timeline-assistant MarkdownBlock > .code_inline {
    color: $nx-success;
    background: transparent;
}

.reference-demo .timeline-assistant MarkdownFence {
    background: transparent;
    margin: 1 0;
}

.reference-demo .timeline-assistant MarkdownFence > Label {
    background: transparent;
    padding: 0;
    color: $nx-error !important;
}

#permission-description {
    height: auto;
    width: 1fr;
    margin-bottom: 1;
    color: $nx-text;
}

#worktrees-dialog, #worktree-confirm-dialog {
    width: 96%;
    max-width: 150;
    height: 90%;
    max-height: 90%;
    padding: 1 2;
    background: $nx-panel;
    border: tall $nx-border-strong;
}

#worktree-confirm-dialog {
    width: 88%;
    max-width: 110;
    height: auto;
    max-height: 88%;
}

#worktrees-title, #worktree-confirm-title {
    height: 1;
    margin-bottom: 1;
    color: $nx-accent;
    text-style: bold;
}

#worktrees-content {
    height: 1fr;
    min-height: 5;
}

#worktrees-list-column {
    width: 32%;
    min-width: 18;
    border-right: solid $nx-border;
    padding-right: 1;
}

#worktrees-list-heading {
    height: 1;
    color: $nx-purple;
    text-style: bold;
}

#worktrees-list-scroll, #worktrees-detail-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#worktrees-list-items {
    height: auto;
}

#worktrees-list-items Button {
    width: 1fr;
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin: 0;
    border: none;
    background: transparent;
    color: $nx-muted;
    text-align: left;
}

#worktrees-list-items Button:hover, #worktrees-list-items Button:focus {
    background: $nx-element-hi;
    color: $nx-text;
    border-left: tall $nx-accent;
}

#worktrees-detail-column {
    width: 1fr;
    padding-left: 1;
}

#worktrees-status {
    height: auto;
    max-height: 2;
    margin-bottom: 1;
    color: $nx-muted;
}

#worktrees-status.error {
    color: $nx-error;
}

#worktrees-detail, #worktree-confirm-description {
    width: 1fr;
    height: auto;
    color: $nx-text;
}

#worktrees-actions, #worktrees-pages, #worktree-confirm-actions {
    height: auto;
    min-height: 2;
    margin-top: 1;
}

#worktrees-actions Button, #worktrees-pages Button, #worktree-confirm-actions Button {
    width: auto;
    min-width: 12;
    height: 2;
    margin: 0 1 0 0;
}

#worktree-confirm-description {
    max-height: 1fr;
    overflow-y: auto;
}

#permission-dialog Button {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $nx-muted;
    text-align: left;
}

#permission-dialog Button:hover, #permission-dialog Button:focus {
    background: $nx-element-hi;
    color: $nx-accent;
    border-left: tall $nx-accent;
}
