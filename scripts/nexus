#!/usr/bin/env bash
# Nexus 0.10 development launcher.
#
#   nexus                     launch the TUI
#   nexus tui [flags]         launch the TUI, release build (flags: --dark, --light,
#                             --256, --debug for a debug binary, ...)
#   nexus build [--debug]     sync Core, build the TUI (release) and the NSH web app
#                             (after `nexus voice init`, syncs keep the voice extra)
#   nexus web [flags]         serve the NSH web app and open it
#   nexus dev web [flags]     run the hot-reloading web app and open it
#   nexus restart             restart the Core daemon
#   nexus stop                stop the Core daemon
#   nexus migrate             make ~/.nexus the Nexus 0.10 home (asks first; see docs/development.md)
#   nexus status              Core daemon and provider status
#   nexus ps                  Core daemon status only
#   nexus logs                follow the Core daemon log
#   nexus check               tests, lints and shared-file checks
#   nexus test                Core and TUI tests
#   nexus fmt                 format the TUI and regenerate shared files
#   nexus doctor              versions and paths, then Core's checks (daemon code, sign-ins, ...)
#   nexus update              check for a newer release (never installs)
#   nexus core <args>         run the Core CLI (login, chat, session, ...)
#
# Anything not listed is passed to the Core CLI, so `nexus login codex`,
# `nexus chat`, `nexus session list` and friends keep working.
set -euo pipefail

# Resolve the repository even when this file is installed as a symlink.
source_file="${BASH_SOURCE[0]}"
while [ -L "$source_file" ]; do
  target="$(readlink "$source_file")"
  case "$target" in
    /*) source_file="$target" ;;
    *) source_file="$(dirname "$source_file")/$target" ;;
  esac
done
PWD_AT_START="$PWD"
ROOT="$(cd "$(dirname "$source_file")/.." && pwd)"
CORE="$ROOT/nexus-core"
TUI="$ROOT/nexus-tui"
NSH="$ROOT/nexus-nsh"
HOME_DIR="${NEXUS10_HOME:-$HOME/.nexus}"

die() { printf 'nexus: %s\n' "$*" >&2; exit 1; }

ensure_home() {
  # ~/.nexus is Nexus 0.10's only once Core has marked it (`nexus migrate`). A machine with neither it
  # nor a pre-release ~/.nexus10 is fresh; Core creates and marks the directory itself.
  case "$HOME_DIR" in
    "$HOME/.nexus"|"$HOME/.nexus/"*)
      if [ ! -f "$HOME/.nexus/.nexus10-home" ] && { [ -e "$HOME/.nexus" ] || [ -e "$HOME/.nexus10" ]; }; then
        die "$HOME/.nexus is not set up for Nexus 0.10 (old Nexus or a pre-release home); run: nexus migrate"
      fi
      return 0
      ;;
  esac
  mkdir -p "$HOME_DIR"
  chmod 700 "$HOME_DIR"
}

# `nexus voice init` remembers the environment it installed into in
# $NEXUS10_HOME/voice.json. Keep that environment's optional `voice` extra in
# every sync, so a build or a daemon restart never prunes the runtime again.
CORE_EXTRA=()
voice_initialised() {
  local marker="$HOME_DIR/voice.json"
  [ -f "$marker" ] || return 1
  [ -d "$CORE/.venv" ] || return 1
  grep -qF "\"environment\": \"$(cd "$CORE/.venv" && pwd -P)\"" "$marker"
}
if voice_initialised; then CORE_EXTRA=(--extra voice); fi

core() {
  (cd "$CORE" && uv run ${CORE_EXTRA[@]+"${CORE_EXTRA[@]}"} nexus "$@")
}

core_cmd() {
  local extra=""
  if [ "${#CORE_EXTRA[@]}" -gt 0 ]; then extra="--extra voice "; fi
  printf 'uv run --project %s %snexus' "$CORE" "$extra"
}

ensure_uv() {
  command -v uv >/dev/null 2>&1 || die "uv is not on PATH"
}

ensure_cargo() {
  command -v cargo >/dev/null 2>&1 || die "cargo is not on PATH"
}

ensure_npm() {
  command -v npm >/dev/null 2>&1 || die "npm is not on PATH"
  [ -d "$NSH/node_modules" ] || (cd "$NSH" && npm install)
}

ensure_nsh() {
  command -v nsh >/dev/null 2>&1 || die "the nsh CLI is not on PATH (npm install -g nsh?)"
}

tui() {
  ensure_home
  ensure_uv
  ensure_cargo
  local profile=(--release)
  case "${1:-}" in
    --debug) profile=(); shift ;;
    --release) shift ;;
  esac
  (cd "$TUI" && NEXUS_TUI_LAUNCH_DIR="$PWD_AT_START" NEXUS_TUI_CORE_CMD="$(core_cmd)" cargo run --quiet ${profile[@]+"${profile[@]}"} -- "$@")
}

build_all() {
  local release=1
  for arg in "$@"; do
    case "$arg" in
      --release) release=1 ;;
      --debug) release=0 ;;
      *) die "build: unknown argument $arg" ;;
    esac
  done
  ensure_uv
  ensure_cargo
  ensure_npm
  ensure_nsh
  printf '› Core dependencies\n'
  (cd "$CORE" && uv sync ${CORE_EXTRA[@]+"${CORE_EXTRA[@]}"})
  printf '› TUI\n'
  if [ "$release" = 1 ]; then
    (cd "$TUI" && cargo build --release)
  else
    (cd "$TUI" && cargo build)
  fi
  printf '› NSH web app\n'
  (cd "$NSH" && npm run gen && npm run build)
}

web() {
  ensure_home
  ensure_uv
  ensure_npm
  local open_browser=1
  local args=()
  local port="${NEXUS_NSH_PORT:-4820}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-open) open_browser=0 ;;
      --port) shift; port="${1:?--port needs a value}"; args+=(--port "$port") ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  if [ ! -f "$NSH/dist/Nexus/index.html" ]; then
    ensure_nsh
    printf '› building the NSH web app\n'
    (cd "$NSH" && npm run gen && npm run build)
  fi
  # The host starts Core itself if needed, and re-reads daemon.json on restart.
  core daemon start >/dev/null || true
  if [ "$open_browser" = 1 ]; then
    (sleep 1; if command -v open >/dev/null 2>&1; then open "http://127.0.0.1:$port"; elif command -v xdg-open >/dev/null 2>&1; then xdg-open "http://127.0.0.1:$port"; fi) >/dev/null 2>&1 &
  fi
  (cd "$NSH" && NEXUS_NSH_CORE_CMD="$(core_cmd)" exec node scripts/serve.mjs ${args[@]+"${args[@]}"})
}

dev_web() (
  ensure_home
  ensure_uv
  ensure_npm
  ensure_nsh
  local open_browser=1 port="${NEXUS_NSH_PORT:-4820}" dev_port=8790
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-open) open_browser=0 ;;
      --port) shift; port="${1:?--port needs a value}" ;;
      --dev-port) shift; dev_port="${1:?--dev-port needs a value}" ;;
      *) die "dev web: unknown argument $1" ;;
    esac
    shift
  done
  node - "$port" "$dev_port" <<'NODE' || die "dev web: choose two available ports (--port and --dev-port)"
const net = require('node:net');
const ports = process.argv.slice(2).map(Number);
if (ports.some(p => !Number.isInteger(p) || p < 1 || p > 65535) || ports[0] === ports[1]) process.exit(1);
const servers = ports.map(port => {
  const server = net.createServer();
  server.on('error', () => process.exit(1));
  server.listen(port, '127.0.0.1', () => {
    if (servers.every(s => s.listening)) servers.forEach(s => s.close());
  });
  return server;
});
NODE
  (cd "$NSH" && npm run gen)
  core daemon start >/dev/null || true
  local dev_pid='' proxy_pid=''
  cleanup_dev_web() {
    [ -z "$dev_pid" ] || kill "$dev_pid" 2>/dev/null || true
    [ -z "$proxy_pid" ] || kill "$proxy_pid" 2>/dev/null || true
    wait 2>/dev/null || true
  }
  trap cleanup_dev_web EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  (cd "$NSH" && exec nsh dev App.tsx --target web --port "$dev_port") & dev_pid=$!
  (cd "$NSH" && NEXUS_NSH_CORE_CMD="$(core_cmd)" exec node scripts/serve.mjs --port "$port" --upstream "http://127.0.0.1:$dev_port") & proxy_pid=$!
  printf '› Waiting for the hot-reloading web app at http://127.0.0.1:%s (Ctrl-C to stop)\n' "$port"
  while :; do
    kill -0 "$dev_pid" 2>/dev/null || die "dev web: NSH development host stopped"
    kill -0 "$proxy_pid" 2>/dev/null || die "dev web: API proxy stopped"
    if node - "$port" <<'NODE'
const http = require('node:http');
const req = http.get(`http://127.0.0.1:${process.argv[2]}/`, res => { res.resume(); process.exit(res.statusCode === 200 ? 0 : 1); });
req.setTimeout(1000, () => req.destroy());
req.on('error', () => process.exit(1));
NODE
    then break; fi
    sleep 1
  done
  printf '› Web app ready: http://127.0.0.1:%s\n' "$port"
  if [ "$open_browser" = 1 ]; then
    if command -v open >/dev/null 2>&1; then open "http://127.0.0.1:$port" || true
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "http://127.0.0.1:$port" || true; fi
  fi
  while kill -0 "$dev_pid" 2>/dev/null && kill -0 "$proxy_pid" 2>/dev/null; do sleep 1; done
  die "dev web: a development server stopped"
)

restart() {
  ensure_home
  ensure_uv
  core daemon stop >/dev/null 2>&1 || true
  core daemon start
}

status_all() {
  ensure_home
  ensure_uv
  printf 'Core daemon\n'
  core daemon status
  printf '\nProviders\n'
  core status
}

check_all() {
  ensure_uv
  ensure_cargo
  ensure_npm
  ensure_nsh
  printf '› Core tests\n'
  (cd "$CORE" && uv run ${CORE_EXTRA[@]+"${CORE_EXTRA[@]}"} pytest -q && uv run ${CORE_EXTRA[@]+"${CORE_EXTRA[@]}"} ruff check nexus tests)
  printf '› TUI tests and lints\n'
  (cd "$TUI" && cargo test && cargo clippy --all-targets -- -D warnings && cargo fmt --check)
  printf '› Shared interface checks\n'
  (cd "$ROOT" && python3 interface/check_theme.py && python3 interface/check_manifest.py)
  printf '› NSH checks\n'
  (cd "$NSH" && npm run check && npm run test:host)
}

test_all() {
  ensure_uv
  ensure_cargo
  printf '› Core tests\n'
  (cd "$CORE" && uv run ${CORE_EXTRA[@]+"${CORE_EXTRA[@]}"} pytest -q)
  printf '› TUI tests\n'
  (cd "$TUI" && cargo test)
}

fmt_all() {
  ensure_cargo
  ensure_npm
  (cd "$TUI" && cargo fmt)
  (cd "$NSH" && npm run gen)
}

doctor() {
  printf 'repository  %s\n' "$ROOT"
  printf 'home        %s\n' "$HOME_DIR"
  printf 'uv          %s\n' "$(uv --version 2>/dev/null || echo missing)"
  printf 'cargo       %s\n' "$(cargo --version 2>/dev/null || echo missing)"
  printf 'node        %s\n' "$(node --version 2>/dev/null || echo missing)"
  if command -v nsh >/dev/null 2>&1; then
    printf 'nsh         %s\n' "$(nsh --version 2>/dev/null | head -1)"
  else
    printf 'nsh         missing\n'
  fi
  if [ -d "$HOME_DIR" ]; then
    printf '\n'
    core doctor
  else
    printf 'daemon      home not created\n'
  fi
}

usage() {
  awk 'NR > 1 { if ($0 ~ /^#/) { sub(/^# ?/, ""); print } else { exit } }' "$source_file"
}

case "${1:-}" in
  ""|tui|t)
    if [ "${1:-}" = "tui" ] || [ "${1:-}" = "t" ]; then shift; fi
    tui "$@" ;;
  once)                shift; tui --once "$@" ;;
  build|b)             shift; build_all "$@" ;;
  web|w)               shift; web "$@" ;;
  dev)                 shift; [ "${1:-}" = web ] || die "usage: nexus dev web [--no-open] [--port N] [--dev-port N]"; shift; dev_web "$@" ;;
  restart|r)           shift; restart "$@" ;;
  stop)                shift; ensure_home; core daemon stop "$@" ;;
  status|s)            shift; status_all "$@" ;;
  ps)                  shift; ensure_home; core daemon status "$@" ;;
  logs)
    shift
    ensure_home
    log="$HOME_DIR/logs/daemon.log"
    [ -f "$log" ] || die "no daemon log yet at $log"
    tail -f "$log"
    ;;
  check)               shift; check_all "$@" ;;
  test)                shift; test_all "$@" ;;
  fmt)                 shift; fmt_all "$@" ;;
  doctor)              shift; doctor "$@" ;;
  update)              shift; ensure_home; core update "$@" ;;
  core)                shift; core "$@" ;;
  help|-h|--help)      usage ;;
  *)                   core "$@" ;;
esac
