{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "nexus",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "chore",
          "hidden": true
        },
        {
          "type": "refactor",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "nexus-core/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "nexus-core/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='nexus10')].version"
        },
        {
          "type": "toml",
          "path": "nexus-tui/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "nexus-tui/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='nexus-tui')].version"
        },
        {
          "type": "json",
          "path": "nexus-nsh/nsh.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
